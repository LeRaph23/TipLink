# =============================================================================
# TipLink — environment variables reference
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Public (exposed to the browser — no secrets here)
# -----------------------------------------------------------------------------

# Full URL of the app, no trailing slash (e.g. https://app.tiplink.io)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon/public key (Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Stripe publishable key (pk_test_… or pk_live_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Launch-offer end date, as YYYY-MM-DD (optional).
# Drives the countdown in the landing promo banner. Leave unset for no deadline:
# the banner then shows its evergreen text. Only set this to a date the offer
# genuinely ends on — a deadline that keeps getting pushed back is fake urgency,
# and the DGCCRF treats it as a misleading commercial practice.
# NEXT_PUBLIC_LAUNCH_OFFER_ENDS_AT=2026-08-31

# -----------------------------------------------------------------------------
# Server-only secrets (REQUIRED — app will not start without these)
# -----------------------------------------------------------------------------

# Supabase service role key — full DB access, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe secret key (sk_test_… or sk_live_…)
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (whsec_…) — from the Stripe dashboard webhook page
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe product IDs for hardware packs (create in Stripe dashboard > Products).
# The app reads each product's default_price, so changing the tariff in Stripe
# propagates automatically — no env change or redeploy needed.
# REQUIRED in production — without them the app logs an error and falls back to
# the hardcoded amounts in lib/env.ts, which are NOT linked to Stripe.
STRIPE_PRODUCT_PACK_SOLO=prod_...
STRIPE_PRODUCT_PACK_DUO=prod_...
# The struck-through "regular" price is read from each product's
# `list_price_cents` metadata key in the Stripe dashboard (an integer, in
# cents, greater than the charged amount). Leave it unset on a product and no
# strikethrough or savings badge is shown for that pack.
# Set it only to a price you have actually charged: art. L112-1-1 code de la
# consommation requires the announced reference to be the lowest price applied
# in the 30 days before the reduction.

# Cron secret — protects /api/cron/*. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Cold-email unsubscribe link signing secret — distinct from CRON_SECRET so a
# leak of one does not allow forging the other. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLD_EMAIL_UNSUB_SECRET=

# Lifecycle-email unsubscribe link signing secret — distinct from the others.
# Optional: if absent, automated lifecycle emails omit the unsubscribe link.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIFECYCLE_EMAIL_UNSUB_SECRET=

# Onboarding express token signing secret — used to sign the /onboarding link
# embedded in pack-purchase confirmation emails. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONBOARDING_TOKEN_SECRET=

# Demo seed route gate. Set to "true" only in disposable preview environments
# where you intentionally want /api/dev/seed-demo to be callable.
SEED_DEMO_ENABLED=false

# -----------------------------------------------------------------------------
# Email — Resend (optional — emails silently skipped when absent)
# -----------------------------------------------------------------------------

RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=TipLink <no-reply@tiplink.io>
CONTACT_NOTIFICATION_EMAIL=team@tiplink.io

# -----------------------------------------------------------------------------
# Ambassador system (optional — ambassador routes return 500 when absent)
# -----------------------------------------------------------------------------

# Minimum 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AMBASSADOR_SESSION_SECRET=

# Telegram bot notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Google Places API (optional)
# -----------------------------------------------------------------------------

# Server-side key for Google Places API (New). Powers (1) salon prospecting
# enrichment and (2) the onboarding/dashboard "Google review link" picker.
# When absent, both features degrade gracefully (manual link entry only).
# Enable "Places API (New)" in Google Cloud Console and restrict the key by API.
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Rate limiting — Upstash Redis (optional — falls back to in-memory per instance)
# -----------------------------------------------------------------------------

# Without Redis, rate limiting is per-serverless-instance only (less effective).
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
