{
  "name": "tiplink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run __tests__/rls",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "db:migrate": "supabase db push",
    "setup:stripe": "npx tsx scripts/stripe-setup.ts",
    "check:env": "npx tsx scripts/check-env.ts"
  },
  "dependencies": {
    "@stripe/connect-js": "^3.3.35",
    "@stripe/react-connect-js": "^3.3.34",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@types/leaflet": "^1.9.21",
    "ibantools": "^4.5.4",
    "leaflet": "^1.9.4",
    "nanoid": "^5.1.9",
    "next": "16.2.4",
    "next-intl": "^4.9.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "supabase": "^2.93.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
